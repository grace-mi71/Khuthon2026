__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
*.log
logs/

# ── Jupyter ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Next.js ─────────────────────────────────────────────────────────────
web/.next/
web/out/
web/node_modules/
web/.vercel/
