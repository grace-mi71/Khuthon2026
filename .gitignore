# ── 문서 / 내부 도구 ────────────────────────────────────────────────────
/docs/*
/everything-claude-code/*

# ── 노트북 (Colab API 키 하드코딩 가능성) ───────────────────────────────
/notebooks/*

# ── 환경 변수 / API 키 ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.local.example

# ── 데이터 (대용량 / 재생성 가능) ────────────────────────────────────────
data/profiles.json
data/embeddings.json
data/contents.json
data/genre_centroids.json
data/trends.json
