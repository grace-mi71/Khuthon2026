# 딴길 — API 키 설정 예시
# 이 파일을 복사해 .env 를 만들고 실제 값을 입력하세요:
#   cp .env.example .env

# KOPIS (공연예술통합전산망)
# 발급: https://www.kopis.or.kr/openApi/restful/index.do
KOPIS_KEY=

# Anthropic (LLM 프로파일링)
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_KEY=

# Naver 검색 API (트렌드 수집)
# 발급: https://developers.naver.com → 애플리케이션 등록 → 검색 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 (트렌드 수집)
# 발급: https://console.cloud.google.com → YouTube Data API v3 활성화
YOUTUBE_API_KEY=
